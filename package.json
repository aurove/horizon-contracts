{
  "name": "@aurove/horizon-contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "forge build && hardhat compile",
    "compile": "hardhat compile",
    "test": "forge test",
    "test:deploy": "hardhat test",
    "clean": "forge clean && hardhat clean",
    "fmt": "forge fmt --check",
    "typecheck": "tsc --noEmit",
    "deploy": "hardhat deploy",
    "deploy:reset": "hardhat deploy --network localhost --reset",
    "verify:testnet": "hardhat deploy --tags Verify --network testnet",
    "verify:mainnet": "hardhat deploy --tags Verify --network mainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "hardhat-deploy": "^0.12.4",
    "hardhat-deploy-ethers": "^0.4.2",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  }
}

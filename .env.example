# Copy this file to `.env` and fill in the values you need locally.

# -----------------------------------------------------------------------------
# Hardhat / deploy configuration
# -----------------------------------------------------------------------------

# Testnet RPC used by Hardhat networks and Foundry rpc_endpoints.
TESTNET_RPC_URL=https://rpc.test.mezo.org

# Mainnet RPC used by deploy:mainnet and forge fork tests (accountState ABI).
MAINNET_RPC_URL=

# Optional fork overrides. Set FORK_ENABLED=1 to enable Hardhat forking.
FORK_ENABLED=
FORK_RPC_URL=
FORK_BLOCK_NUMBER=

# RPC endpoint for the running local Hardhat node used by `hardhat deploy --network localhost`.
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# Optional account private keys used by the `testnet` and `mainnet` Hardhat networks.
TESTNET_PRIVATE_KEY=
MAINNET_PRIVATE_KEY=
